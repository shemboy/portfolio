@page "/"

<PageTitle>Shem M. Dualos | Cybersecurity Specialist</PageTitle>

<div class="portfolio-container">
    <!-- Header / Terminal Welcome -->
    <div class="terminal-header">
        <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-text">whoami</span>
        </div>
        <div class="terminal-output">shem_m_dualos@portfolio:~$</div>
    </div>

    <!-- Main Content -->
    <div class="portfolio-grid">
        <!-- Left Column -->
        <div class="profile-section">
            <!-- Profile Image -->
            <div class="profile-image-container">
                <img src="image/shem.jpg" alt="Shem M. Dualos" class="profile-image" />
                <div class="scan-line"></div>
            </div>

            <!-- Name and Title -->
            <h1 class="hacker-name">SHEM M. DUALOS</h1>
            <p class="hacker-title">// CYBERSECURITY SPECIALIST</p>

            <!-- Status Indicator -->
            <div class="status-badge">
                <span class="status-dot"></span>
                <span class="status-text">ONLINE</span>
            </div>
        </div>

        <!-- Right Column -->
        <div class="info-section">
            <!-- About Section -->
            <section class="info-block">
                <h2 class="section-title">[ ABOUT ]</h2>
                <div class="info-content">
                    <p>Security-focused professional with expertise in cyber threat analysis, penetration testing, and network defense. Passionate about identifying vulnerabilities and strengthening digital infrastructure.</p>
                </div>
            </section>

            <!-- Experience Section -->
            <section class="info-block">
                <h2 class="section-title">[ EXPERIENCE ]</h2>
                <div class="experience-item">
                    <div class="exp-header">
                        <h3 class="exp-title">Cybersecurity Specialist</h3>
                        <span class="exp-duration">2 YEARS</span>
                    </div>
                    <p class="exp-description">Industry experience in vulnerability assessment, threat detection, and security infrastructure implementation. Specialized in identifying and mitigating cyber threats across enterprise environments.</p>
                </div>
            </section>

            <!-- Education Section -->
            <section class="info-block">
                <h2 class="section-title">[ EDUCATION ]</h2>
                <div class="edu-item">
                    <h3 class="edu-school">CTU Daanbantayan</h3>
                    <p class="edu-program">Information Technology / Cybersecurity Focus</p>
                </div>
            </section>

            <!-- Skills Section -->
            <section class="info-block">
                <h2 class="section-title">[ SKILLS ]</h2>
                <div class="skills-grid">
                    <span class="skill-tag">> Penetration Testing</span>
                    <span class="skill-tag">> Network Security</span>
                    <span class="skill-tag">> Threat Analysis</span>
                    <span class="skill-tag">> Vulnerability Assessment</span>
                    <span class="skill-tag">> Incident Response</span>
                    <span class="skill-tag">> Security Auditing</span>
                </div>
            </section>

            <!-- Contact Section -->
            <section class="info-block">
                <h2 class="section-title">[ CONNECT ]</h2>
                <div class="contact-links">
                    <a href="mailto:shem.dualos@email.com" class="contact-btn">EMAIL</a>
                    <a href="https://linkedin.com" target="_blank" class="contact-btn">LINKEDIN</a>
                    <a href="https://github.com" target="_blank" class="contact-btn">GITHUB</a>
                </div>
            </section>
        </div>
    </div>

    <!-- Footer Terminal -->
    <div class="terminal-footer">
        <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-text blinking">_</span>
        </div>
    </div>
</div>
